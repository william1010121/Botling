{
  "name": "deck-latex",
  "displayName": "LaTeX 公式",
  "version": "1.0.0",
  "description": "訊息裡的 $…$、$$…$$、\\(…\\)、\\[…\\] 用 KaTeX 排版；輸入框打公式時即時預覽；複製公式時複製回 TeX。",
  "license": "MIT",
  "engines": { "deck": "^2.0.0" },
  "deck": {
    "permissions": ["composer", "messages"],
    "web": "dist/web.js",
    "styles": ["dist/katex.min.css"],
    "contributes": {
      "commands": [
        { "id": "deck-latex.insert", "title": "插入行內公式", "key": "cmd+shift+m" }
      ],
      "settings": {
        "deck-latex.preview": { "type": "boolean", "default": true, "title": "輸入時預覽公式" },
        "deck-latex.copyTeX": { "type": "boolean", "default": true, "title": "複製公式時複製 TeX" }
      }
    }
  }
}
