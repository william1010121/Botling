# Test hosts for desktop/scripts/remote-test.sh. Copy this file to remote-test.local.env (git does not track that
# file) and put your own ssh host names (Host aliases from ~/.ssh/config) in it. KEY=value lines only.
# Slots: runs allowed at once on that host; measure what yours takes (see the script's header).
BOTLING_TEST_HOST=primary-test-host
BOTLING_TEST_HOST_SLOTS=8
# Optional: used when the primary does not answer ssh.
BOTLING_TEST_FALLBACK=fallback-test-host
BOTLING_TEST_FALLBACK_SLOTS=2
