<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Botling 2.0 under the hardened runtime (used only when signing with a real Developer ID; an ad-hoc
     build is signed without the hardened runtime). V8's JIT needs the first two; nothing else is asked:
     no camera, microphone, location, Apple events or library-validation exceptions. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
