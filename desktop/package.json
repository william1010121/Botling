{
  "name": "botling-desktop",
  "version": "2.0.0-dev.0",
  "private": true,
  "description": "Botling 2.0: cross-platform desktop app (React + TypeScript + Electron).",
  "main": "out/main/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && BOTLING_AGENT=claude electron .",
    "dev:fake": "node build.mjs && BOTLING_AGENT=fake electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node build.mjs && vitest run test/unit",
    "test:e2e": "node build.mjs && playwright test",
    "test:live": "node build.mjs && BOTLING_LIVE_CLAUDE=1 vitest run test/live"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
