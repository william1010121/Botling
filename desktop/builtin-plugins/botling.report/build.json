{
  "bundles": [
    {
      "entry": "reports/cli-main.ts",
      "outfile": "report.cjs",
      "minify": true,
      "jsx": true,
      "cssAsText": true,
      "notices": "THIRD_PARTY_LICENSES.txt"
    }
  ],
  "copy": [
    {
      "from": "docs/report-blocks.md",
      "to": "skills/report/report-blocks.md"
    },
    {
      "from": "reports/v2/examples/figures/per_subject.py",
      "to": "skills/report/per_subject.py"
    },
    {
      "from": "reports/v2/examples/figures/flowchart.py",
      "to": "skills/report/flowchart.py"
    },
    {
      "from": "reports/v2/examples/figures/paired.py",
      "to": "skills/report/paired.py"
    },
    {
      "from": "reports/v2/NOTICE",
      "to": "NOTICE"
    }
  ]
}
