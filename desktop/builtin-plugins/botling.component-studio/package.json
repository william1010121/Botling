{
  "name": "botling.component-studio",
  "displayName": "Component studio",
  "version": "1.0.0",
  "description": "Turns a bot's own <suggest-component> chip under a reply into a component: pressed, Maintainer builds it and the bot that wrote the reply draws it under that reply.",
  "license": "GPL-3.0-or-later",
  "publisher": "Botling",
  "engines": {
    "ccb": "^2.0.0"
  },
  "ccb": {
    "kernel": 1,
    "provides": { "services": ["studio.specButton"], "slots": [] },
    "requires": { "services": [] },
    "uses": { "services": [] },
    "permissions": [
      "studio"
    ],
    "host": "dist/host.mjs",
    "web": "dist/web.js",
    "styles": [
      "studio.css"
    ],
    "contributes": {
      "replyTags": [
        {
          "tag": "suggest-component"
        },
        {
          "tag": "component-spec"
        }
      ]
    }
  }
}
