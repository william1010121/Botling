{
  "name": "ccb-latex",
  "displayName": "LaTeX",
  "version": "1.0.0",
  "description": "Typesets $…$, $$…$$, \\(…\\) and \\[…\\] in messages with KaTeX, previews formulas while you type, and copies formulas as TeX.",
  "license": "GPL-3.0-or-later",
  "engines": { "ccb": "^2.0.0" },
  "ccb": {
    "permissions": ["composer", "messages"],
    "web": "dist/web.js",
    "styles": ["dist/katex.min.css"],
    "contributes": {
      "commands": [
        { "id": "ccb-latex.insert", "title": "Insert inline formula", "key": "cmd+shift+m" }
      ],
      "settings": {
        "ccb-latex.preview": { "type": "boolean", "default": true, "title": "Preview formulas while typing" },
        "ccb-latex.copyTeX": { "type": "boolean", "default": true, "title": "Copy formulas as TeX" }
      }
    }
  }
}
